# Standalone example: when sharing a host with server/api.py, choose a distinct
# listener port and update these upstreams; keep its existing /api/ location.
# Include this inside an existing HTTPS server block after substituting paths.
# The host's TLS, certificate renewal, and request limits remain deployment configuration.
# Raw nginx request/error messages can contain query strings and credentials.
# Use the API fixed-field diagnostics; configure any gateway diagnostics separately.
access_log off;
error_log /dev/null;

root /srv/agent-forge/site;
index index.html;

location = /health/live {
    proxy_pass http://127.0.0.1:8791;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
}
location = /health/ready {
    proxy_pass http://127.0.0.1:8791;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
}
location /api/v1/ {
    proxy_pass http://127.0.0.1:8791;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;
    proxy_send_timeout 10s;
    proxy_request_buffering on;
    proxy_buffering on;
    client_max_body_size 1k;
}
location / {
    try_files $uri $uri/ =404;
}
# Do not expose the public runtime directory as a static root or alias.
# Preserve query strings in any CDN cache key for fingerprinted static assets.
