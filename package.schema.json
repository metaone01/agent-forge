{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaone01.github.io/agent-forge/package.schema.json",
  "title": "Agent Package Metadata",
  "description": "Records information only. Installation is redirected to the target repository. No detection is performed here.",
  "type": "object",
  "required": ["schemaVersion", "name", "version", "description", "license", "target"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Metadata schema version. Increment on breaking changes."
    },
    "name": { "$ref": "#/$defs/packageName" },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "The publisher's original version string. Consumers interpret it in the target repository's versioning context."
    },
    "versionKind": {
      "type": "string",
      "enum": ["semver", "pep440", "calver", "other"],
      "description": "Optional hint for indexing and comparison; it does not rewrite the original version."
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "license": { "$ref": "#/$defs/stringOrArray" },
    "homepage": { "$ref": "#/$defs/url" },
    "repository": { "$ref": "#/$defs/url", "description": "Source repository URL." },
    "documentation": { "$ref": "#/$defs/url" },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "maintainers": {
      "type": "array",
      "items": { "$ref": "#/$defs/maintainer" },
      "minItems": 1
    },

    "arch": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "os": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "libc": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },

    "target": { "$ref": "#/$defs/target" },

    "supportedAgents": {
      "type": "array",
      "items": { "$ref": "#/$defs/supportedAgent" },
      "uniqueItems": true
    },

    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    },
    "depends": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "optionalDepends": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "makedepends": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "provides": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "replaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },

    "lifecycle": { "$ref": "#/$defs/lifecycle" },

    "security": { "$ref": "#/$defs/security" },
    "securityRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/securityRef" }
    },
    "securityPolicyHints": { "$ref": "#/$defs/policyHints" },

    "publishedAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "_meta": { "$ref": "#/$defs/extensionMeta" }
  },

  "$defs": {
    "packageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 214,
      "pattern": "^[A-Za-z0-9@][A-Za-z0-9._@/+-]*$",
      "description": "A source-local record name. Names are not globally unique; source category and source name form part of the identity."
    },
    "extensionMeta": {
      "type": "object",
      "description": "Namespaced extension data for private consumer metadata, experimental fields, or a structured description of an uncategorized agent tool. Consumers must preserve unknown values without interpreting them.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+(/[a-z0-9-]+)?$"
      },
      "additionalProperties": true
    },
    "url": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "stringOrArray": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },

    "versionRangeType": {
      "type": "string",
      "enum": [
        "semver",
        "npm",
        "pep440",
        "calver",
        "custom"
      ]
    },
    "versionConstraint": {
      "type": "object",
      "required": ["range"],
      "additionalProperties": false,
      "properties": {
        "range": { "type": "string", "minLength": 1 },
        "rangeType": { "$ref": "#/$defs/versionRangeType" }
      }
    },

    "maintainer": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "url": { "$ref": "#/$defs/url" },
        "role": {
          "type": "string",
          "enum": ["author", "maintainer", "contributor", "security"]
        }
      }
    },

    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "sha512": { "type": "string", "pattern": "^[a-fA-F0-9]{128}$" },
        "blake2b": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/url" },
        "type": {
          "type": "string",
          "enum": ["gpg", "pgp", "minisign", "sigstore", "cosign"]
        },
        "keyId": { "type": "string" },
        "keyUrl": { "$ref": "#/$defs/url" }
      }
    },
    "mirror": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/url" },
        "priority": { "type": "integer", "minimum": 0 },
        "region": { "type": "string" }
      }
    },
    "agentInstall": {
      "type": "object",
      "description": "An installation instruction record, not authorization to execute it. Consumers must obtain confirmation before execution.",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["command", "url", "api", "script"]
        },
        "command": { "type": "string" },
        "url": { "$ref": "#/$defs/url" },
        "scriptIntegrity": {
          "type": "string",
          "minLength": 1,
          "description": "Integrity material for a script URL, preferably an SRI value such as sha256-<base64>."
        },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "command" } } },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "type": { "const": "url" } } },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "type": { "const": "api" } } },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "type": { "const": "script" } } },
          "then": { "required": ["url", "scriptIntegrity"] }
        }
      ]
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "human": { "$ref": "#/$defs/url" },
        "agent": { "$ref": "#/$defs/agentInstall" },
        "steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "string",
          "description": "Human-readable installation notes. Script URLs must be traceable to target.url or target.mirrors; this schema records instructions and never executes them."
        }
      }
    },

    "mcpRef": {
      "type": "object",
      "required": ["registryType", "identifier"],
      "additionalProperties": false,
      "properties": {
        "registryType": {
          "type": "string",
          "enum": ["npm", "pypi", "nuget", "cargo", "oci", "mcpb"]
        },
        "registryBaseUrl": {
          "$ref": "#/$defs/url",
          "description": "Registry base URL. See README.md for the maintained allowlist; the schema deliberately does not freeze that mutable list."
        },
        "identifier": { "type": "string", "minLength": 1 },
        "environmentVariables": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "transport": {
          "type": "string",
          "enum": ["stdio", "streamable-http", "sse"]
        },
        "remotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "type"],
            "additionalProperties": false,
            "properties": {
              "url": { "$ref": "#/$defs/url" },
              "type": { "type": "string", "enum": ["streamable-http", "sse"] }
            }
          }
        }
      }
    },
    "agentPluginRef": {
      "type": "object",
      "required": ["pluginManifestPath", "sourceType"],
      "additionalProperties": false,
      "properties": {
        "pluginManifestPath": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the plugin manifest, commonly .claude-plugin/plugin.json."
        },
        "sourceType": { "type": "string", "enum": ["git", "local", "registry"] },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/$defs/supportedAgent" },
          "uniqueItems": true
        },
        "marketplaceUrl": { "$ref": "#/$defs/url" }
      }
    },
    "skillRef": {
      "type": "object",
      "required": ["skillMarkdownPath"],
      "additionalProperties": false,
      "properties": {
        "skillMarkdownPath": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the skill definition, normally SKILL.md."
        },
        "license": { "type": "string", "minLength": 1 },
        "compatibility": { "type": "string", "maxLength": 500 },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "allowedTools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "genericRef": {
      "type": "object",
      "description": "Identity and scope evidence for an agent-related tool that does not fit the MCP, plugin, or skill categories.",
      "required": ["kind", "agentUse"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Concise tool kind, such as prompt-library, agent-ui, or evaluation-harness."
        },
        "agentUse": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "How the tool is directly used to build, operate, evaluate, or extend an AI agent workflow."
        }
      }
    },
    "linkCheck": {
      "type": "object",
      "required": ["lastCheckedAt", "lastStatus"],
      "additionalProperties": false,
      "properties": {
        "lastCheckedAt": { "$ref": "#/$defs/timestamp" },
        "lastStatus": { "type": "string", "enum": ["ok", "redirect", "broken"] },
        "finalUrl": { "$ref": "#/$defs/url" },
        "okSince": { "$ref": "#/$defs/timestamp" },
        "brokenSince": { "$ref": "#/$defs/timestamp" }
      }
    },

    "target": {
      "type": "object",
      "required": ["type", "repository"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "agent-plugin",
            "mcp",
            "skill",
            "generic"
          ]
        },
        "repository": { "type": "string", "minLength": 1 },
        "package": { "$ref": "#/$defs/packageName" },
        "version": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "checksum": { "$ref": "#/$defs/checksum" },
        "signature": { "$ref": "#/$defs/signature" },
        "mirrors": {
          "type": "array",
          "items": { "$ref": "#/$defs/mirror" }
        },
        "install": { "$ref": "#/$defs/install" },
        "typeRef": {
          "type": "object",
          "description": "Category-specific identity and discovery metadata. Its shape is selected by target.type."
        },
        "verified": {
          "type": "boolean",
          "description": "Whether publication-time checks passed: the URL was reachable, supplied checksums matched, or the registry contained the identifier. This is not a security guarantee."
        },
        "verifiedAt": {
          "$ref": "#/$defs/timestamp",
          "description": "Time of the publication-time verification represented by verified."
        },
        "linkCheck": { "$ref": "#/$defs/linkCheck" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "mcp" } }, "required": ["type"] },
          "then": { "properties": { "typeRef": { "$ref": "#/$defs/mcpRef" } }, "required": ["typeRef"] }
        },
        {
          "if": { "properties": { "type": { "const": "agent-plugin" } }, "required": ["type"] },
          "then": { "properties": { "typeRef": { "$ref": "#/$defs/agentPluginRef" } }, "required": ["typeRef"] }
        },
        {
          "if": { "properties": { "type": { "const": "skill" } }, "required": ["type"] },
          "then": { "properties": { "typeRef": { "$ref": "#/$defs/skillRef" } }, "required": ["typeRef"] }
        },
        {
          "if": { "properties": { "type": { "const": "generic" } }, "required": ["type"] },
          "then": { "properties": { "typeRef": { "$ref": "#/$defs/genericRef" } }, "required": ["typeRef"] }
        }
      ]
    },

    "supportedAgent": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "versionRange": { "type": "string", "minLength": 1 },
        "rangeType": { "$ref": "#/$defs/versionRangeType" },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/conflict" }
        },
        "notes": { "type": "string" }
      }
    },

    "dependency": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/packageName" },
            "versionRange": { "type": "string" },
            "rangeType": { "$ref": "#/$defs/versionRangeType" },
            "repository": { "type": "string" },
            "optional": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "conflict": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/packageName" },
            "versionRange": { "type": "string" },
            "rangeType": { "$ref": "#/$defs/versionRangeType" },
            "repository": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      ]
    },

    "deprecated": {
      "type": "object",
      "required": ["is"],
      "additionalProperties": false,
      "properties": {
        "is": { "type": "boolean" },
        "reason": { "type": "string" },
        "replacement": { "$ref": "#/$defs/packageName" },
        "repository": { "type": "string" },
        "since": { "$ref": "#/$defs/timestamp" }
      }
    },
    "yanked": {
      "type": "object",
      "required": ["is"],
      "additionalProperties": false,
      "properties": {
        "is": { "type": "boolean" },
        "reason": { "type": "string" },
        "at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "rename": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": {
        "to": { "$ref": "#/$defs/packageName" },
        "repository": { "type": "string" },
        "version": { "type": "string" },
        "since": { "$ref": "#/$defs/timestamp" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deprecated": { "$ref": "#/$defs/deprecated" },
        "archived": { "type": "boolean" },
        "prerelease": { "type": "boolean" },
        "yanked": { "$ref": "#/$defs/yanked" },
        "rename": { "$ref": "#/$defs/rename" },
        "linkStatusNote": {
          "type": "string",
          "description": "Operator note for link degradation or a pending replacement."
        }
      }
    },

    "severity": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "critical", "unknown"]
    },
    "advisory": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "severity": { "$ref": "#/$defs/severity" },
        "cvss": {
          "type": "object",
          "required": ["score"],
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string" },
            "score": { "type": "number", "minimum": 0, "maximum": 10 },
            "vector": { "type": "string" }
          }
        },
        "cwe": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": { "type": "string" },
        "impact": { "type": "string" },
        "affected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "range": { "type": "string" },
            "rangeType": { "$ref": "#/$defs/versionRangeType" },
            "introduced": { "type": "string" },
            "fixed": { "type": "string" },
            "lastAffected": { "type": "string" }
          }
        },
        "fixedIn": { "type": "string" },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/url" }
        },
        "publishedAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "status": {
          "type": "string",
          "enum": ["confirmed", "unconfirmed", "disputed", "rejected", "fixed"]
        },
        "source": { "type": "string" },
        "sourceUrl": { "$ref": "#/$defs/url" }
      }
    },
    "securitySummary": {
      "type": "object",
      "required": ["count", "asOf"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "highestSeverity": { "$ref": "#/$defs/severity" },
        "asOf": { "$ref": "#/$defs/timestamp" },
        "source": { "type": "string" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "sourceUrl": { "$ref": "#/$defs/url" },
        "asOf": { "$ref": "#/$defs/timestamp" },
        "ttl": {
          "type": "integer",
          "minimum": 0,
          "description": "Seconds after asOf before this snapshot should be refreshed."
        },
        "disclaimer": {
          "type": "string",
          "description": "Must state: Third-party data. Not a detection result. No guarantee of accuracy, completeness, timeliness, or safety."
        },
        "summary": { "$ref": "#/$defs/securitySummary" },
        "advisories": {
          "type": "array",
          "items": { "$ref": "#/$defs/advisory" }
        }
      }
    },
    "securityRef": {
      "type": "object",
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "policyHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockOnSeverity": {
          "type": "array",
          "items": { "$ref": "#/$defs/severity" },
          "uniqueItems": true
        },
        "warnOnSeverity": {
          "type": "array",
          "items": { "$ref": "#/$defs/severity" },
          "uniqueItems": true
        },
        "requiresUserConfirmation": { "type": "boolean" },
        "minAgeDays": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
